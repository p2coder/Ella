  "cards": [
    {
      "dot": "cyan",
      "title": "输入与交付",
      "items": [
        "文本与有界录音经事件管线创建任务；PresenceRuntime 执行中断策略。",
        "AppRuntime 直接转发暂停、恢复、取消和追问回答；SSE 推送状态与结果。"
      ]
    },
    {
      "dot": "emerald",
      "title": "任务执行闭环",
      "items": [
        "First Decision 建立意图；CALL_TOOL 后继续推理，SUBMIT_RESULT 后验证。",
        "Task 独占状态和 CapabilityScope；plan_written 激活 TaskGraph wave 并发。"
      ]
    },
    {
      "dot": "amber",
      "title": "持久化与外部边界",
      "items": [
        "TaskStore 保存 JSON checkpoint；MemoryManager 写记忆，TraceRecorder 记录过程。",
        "PlanWrittenTool 使用 Git PlanStore；模型、网页及设备通过各自适配层访问。"
      ]
    }
  ]
